{
  "manifest_version": 3,
  "name": "Pete's Garden Zebra Labels",
  "version": "1.0.4",
  "description": "Print validated label rows from approved Google Sheets to a Zebra printer.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/content-bridge.js"
      ],
      "matches": [
        "https://docs.google.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": ""
}
